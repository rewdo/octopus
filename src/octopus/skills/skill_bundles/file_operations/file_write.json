{
  "name": "file_write",
  "version": "1.0.0",
  "category": "file_operations",
  "description": "Write content to a file with encoding options, backup creation, and directory auto-creation.",
  "author": "octopus",
  "tags": ["file", "write", "io", "save"],
  "cost_estimate": 0.0001,
  "success_rate": 0.99,
  "steps": [
    {
      "action": "file_write",
      "params": {
        "path": "{file_path}",
        "content": "{file_content}",
        "encoding": "{encoding}",
        "mode": "{write_mode}",
        "create_dirs": true
      },
      "on_error": "retry",
      "description": "Write content to file"
    }
  ]
}
