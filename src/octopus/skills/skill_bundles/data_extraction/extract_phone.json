{
  "name": "extract_phone",
  "version": "1.0.0",
  "category": "data_extraction",
  "description": "Extract phone numbers in international and local formats. Supports CN, US, and generic patterns.",
  "author": "octopus",
  "tags": ["extract", "phone", "contact", "regex", "data"],
  "cost_estimate": 0.0003,
  "success_rate": 0.97,
  "steps": [
    {
      "action": "extract_regex",
      "params": {
        "pattern": "(?:(?:\\+?86)|(?:\\(\\+86\\)))?\\s*1[3-9]\\d{9}|(?:\\+?1[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}",
        "input": "{input_text}",
        "flags": ""
      },
      "on_error": "skip",
      "description": "Extract phone numbers (CN and US formats)"
    }
  ]
}
